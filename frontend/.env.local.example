# Copy file này thành .env.local rồi điền giá trị thật (KHÔNG commit .env.local lên git)

# URL backend .NET (mục 8 - REST API spec)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Chạy `npx auth secret` để tự sinh giá trị này (Auth.js v5)
AUTH_SECRET=

# URL của chính app Next.js này khi chạy local
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (FR-AUTH-003) - lấy từ Google Cloud Console, có thể để trống lúc mới bắt đầu
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
